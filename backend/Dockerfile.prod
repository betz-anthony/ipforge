FROM python:3.12-slim AS builder
WORKDIR /app
ENV DEBIAN_FRONTEND=noninteractive
COPY requirements.txt .
# pywinrm[kerberos] pulls pykerberos, a C extension with no published wheels:
# it needs a toolchain and the krb5 headers to build here. Only the compiled
# site-packages are copied forward, so none of this reaches the final image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev libkrb5-dev \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir -r requirements.txt

FROM python:3.12-slim
WORKDIR /app
ENV DEBIAN_FRONTEND=noninteractive
# libkrb5-3/libgssapi-krb5-2 are what the copied pykerberos extension links
# against at run time; krb5-user supplies kinit/klist for debugging. Kerberos
# realm config still comes from a mounted /etc/krb5.conf.
# upgrade picks up base-image security fixes the tag itself lags behind —
# python:3.12-slim ships whatever was current when it was built.
RUN apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends \
      iputils-ping curl libkrb5-3 libgssapi-krb5-2 krb5-user \
 && rm -rf /var/lib/apt/lists/* \
 && adduser --disabled-password --gecos '' --uid 1000 appuser
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin/uvicorn /usr/local/bin/uvicorn
COPY --from=builder /usr/local/bin/alembic /usr/local/bin/alembic
COPY . .
USER appuser
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
